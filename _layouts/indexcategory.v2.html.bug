---
layout: default
---
{{ content }}

<div id="posts-container" class="row pe-0">
  <!-- Initial loading spinner -->
  <div class="col-12 text-center py-5" id="initial-spinner">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading posts…</span>
    </div>
  </div>
</div>

<div id="loadmore-container" class="text-center mt-4 mb-5" style="display: none;">
  <button id="loadmore-btn" class="btn btn-primary btn-lg px-5 py-2 rounded-pill shadow-sm transition-transform" aria-label="Load more posts">
    <i class="fas fa-arrow-down mr-2" aria-hidden="true"></i> Load more posts
    <i class="fas fa-spinner fa-pulse d-none ml-2" id="loadmore-spinner" aria-hidden="true"></i>
  </button>
</div>

<template id="card-template">
  <div class="col-lg-4 col-md-6 col-12 mb-4 fade-in-up">
    <div class="card chulapa-border-card-index rounded-4 shadow-sm h-100 position-relative overflow-hidden hover-lift">
      <div class="row g-0 h-100">
        <div class="col-sm-12 chulapa-min-h-10 chulapa-card-img chulapa-overlay-img chulapa-gradient image-col"
             style="background-size: cover; background-position: center;" aria-label="Post thumbnail">
        </div>
        <div class="col-sm-12 d-flex flex-column">
          <article class="card-body chulapa-links-hover-only flex-grow-1">
            <a href="#" class="stretched-link title-link text-decoration-none"><h5 class="card-title font-weight-bold"></h5></a>
            <h6 class="card-subtitle mb-2 text-muted subtitle"></h6>
            <div class="card-text mb-3 excerpt text-secondary"></div>
          </article>
          <div class="border-top-0 card-footer border-primary chulapa-bg-transparent mt-auto pb-3">
            <p class="small text-right font-italic mb-2 date"></p>
            <div class="categories-badges mb-1"></div>
            <div class="tags-badges"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  // ----- Helper: Debounce function for resize events -----
  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(this, args), wait);
    };
  }

  // ----- Helper: get posts per page based on screen width -----
  function getPostsPerPage() {
    return window.innerWidth >= 992 ? 15 : 10;
  }

  let currentPage = 1;
  let currentPostsPerPage = getPostsPerPage();
  let isLoading = false;

  // ----- EMBEDDED POSTS DATA -----
  const allPosts = [
    {% assign collection = site[page.include_collection] %}
    {% if page.category_name %}
      {% assign posts_to_show = collection | where: "categories", page.category_name %}
    {% elsif page.tag_name %}
      {% assign posts_to_show = collection | where: "tags", page.tag_name %}
    {% else %}
      {% assign posts_to_show = collection %}
    {% endif %}
    
    {% for post in posts_to_show %}
      {% assign img = post.og_image | default: post.header_img %}
      {
        "title": {{ post.title | jsonify }},
        "subtitle": {{ post.subtitle | jsonify }},
        "date": {{ post.date | date: "%d/%m/%Y" | jsonify }},
        "excerpt": {{ post.excerpt | strip_html | truncatewords: 20 | jsonify }},
        "url": {{ post.url | absolute_url | jsonify }},
        "og_image": {{ img | absolute_url | default: nil | jsonify }},
        "categories": [
          {% for cat in post.categories %}
            { "name": {{ cat | jsonify }}, "url": {{ cat | replace: " ", "-" | prepend: "#" | prepend: post.cloudcategory_url | absolute_url | uri_escape | jsonify }} }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        "tags": [
          {% for tag in post.tags %}
            { "name": {{ tag | jsonify }}, "url": {{ tag | replace: " ", "-" | prepend: "#" | prepend: post.cloudtag_url | absolute_url | uri_escape | jsonify }} }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const totalPosts = allPosts.length;

  // DOM elements
  const container = document.getElementById('posts-container');
  const loadmoreContainer = document.getElementById('loadmore-container');
  const loadmoreBtn = document.getElementById('loadmore-btn');
  const btnSpinner = document.getElementById('loadmore-spinner');
  const initialSpinner = document.getElementById('initial-spinner');

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m]));
  }

  function renderPost(post) {
    const template = document.getElementById('card-template');
    const clone = template.content.cloneNode(true);
    
    const titleLink = clone.querySelector('.title-link');
    titleLink.href = post.url;
    titleLink.querySelector('.card-title').textContent = post.title;
    
    const subtitleEl = clone.querySelector('.subtitle');
    if (post.subtitle) {
      subtitleEl.textContent = post.subtitle;
    } else {
      subtitleEl.style.display = 'none';
    }
    
    clone.querySelector('.excerpt').textContent = post.excerpt;
    
    const dateEl = clone.querySelector('.date');
    if (post.date) {
      dateEl.innerHTML = `<time datetime="${escapeHtml(post.date)}"><i class="far fa-calendar-alt mr-1"></i>${escapeHtml(post.date)}</time>`;
    } else {
      dateEl.parentElement.style.display = 'none';
    }
    
    const imageCol = clone.querySelector('.image-col');
    if (post.og_image) {
      imageCol.style.backgroundImage = `url('${escapeHtml(post.og_image)}')`;
      imageCol.classList.remove('d-none');
    } else {
      imageCol.classList.add('d-none');
    }
    
    const catContainer = clone.querySelector('.categories-badges');
    if (post.categories?.length) {
      post.categories.forEach(cat => {
        const badge = document.createElement('a');
        badge.href = cat.url;
        badge.className = 'badge chulapa-pill-bg-secondary mx-1 z-index-2';
        badge.textContent = cat.name;
        catContainer.appendChild(badge);
      });
    }
    
    const tagContainer = clone.querySelector('.tags-badges');
    if (post.tags?.length) {
      post.tags.forEach(tag => {
        const badge = document.createElement('a');
        badge.href = tag.url;
        badge.className = 'badge chulapa-pill-bg-primary mx-1 z-index-2';
        badge.textContent = tag.name;
        tagContainer.appendChild(badge);
      });
    }
    
    return clone;
  }

  function loadMorePosts() {
    if (isLoading) return;
    isLoading = true;
    
    if (btnSpinner && loadmoreBtn) {
      btnSpinner.classList.remove('d-none');
      loadmoreBtn.disabled = true;
    }
    
    const start = (currentPage - 1) * currentPostsPerPage;
    const end = start + currentPostsPerPage;
    const postsToLoad = allPosts.slice(start, end);
    
    if (postsToLoad.length === 0) {
      replaceWithBackToTop();
      isLoading = false;
      return;
    }
    
    // Simulating slight network delay for visual feedback if desired, or execute immediately
    setTimeout(() => {
      if (initialSpinner) initialSpinner.remove();
      
      const fragment = document.createDocumentFragment();
      postsToLoad.forEach(post => fragment.appendChild(renderPost(post)));
      container.appendChild(fragment);
      
      currentPage++;
      isLoading = false;
      
      if (btnSpinner) btnSpinner.classList.add('d-none');
      if (loadmoreBtn) loadmoreBtn.disabled = false;
      
      if (currentPage * currentPostsPerPage > totalPosts) {
        replaceWithBackToTop();
      }
    }, 150);
  }

  function replaceWithBackToTop() {
    if (!loadmoreContainer) return;
    loadmoreContainer.innerHTML = `
      <button id="backToTopBtn" class="btn btn-secondary btn-lg px-5 py-2 rounded-pill shadow-sm transition-transform">
        <i class="fas fa-arrow-up mr-2"></i> Back to top
      </button>
    `;
    document.getElementById('backToTopBtn')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  function init() {
    currentPostsPerPage = getPostsPerPage();
    currentPage = 1;
    loadmoreContainer.style.display = totalPosts <= currentPostsPerPage ? 'none' : 'block';
    loadMorePosts();
    loadmoreBtn?.addEventListener('click', loadMorePosts);
  }
  
  // Handle layout adjustments intelligently on resize
  window.addEventListener('resize', debounce(() => {
    const newPostsPerPage = getPostsPerPage();
    if (newPostsPerPage !== currentPostsPerPage) {
      currentPostsPerPage = newPostsPerPage;
    }
  }, 250));

  document.addEventListener('DOMContentLoaded', init);
</script>

<style>
  .rounded-4 { border-radius: 0.75rem !important; }
  .stretched-link::after { z-index: 1; }
  .z-index-2 { z-index: 2; position: relative; }
  
  /* Interactions & Animations */
  .transition-transform { transition: transform 0.3s ease, box-shadow 0.3s ease; }
  #loadmore-btn:hover, #backToTopBtn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
  }
  
  .hover-lift { transition: transform 0.2s ease-in-out; }
  .hover-lift:hover { transform: translateY(-4px); }

  .fade-in-up {
    animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chulapa-min-h-10 { min-height: 12rem; }
  @media (min-width: 576px) { .chulapa-min-h-10 { min-height: 10rem; } }
</style>
